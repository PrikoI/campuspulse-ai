# Copy desired values into ignored .env. Never paste JSON keys into tracked files.
CAMPUSPULSE_LMS_REPOSITORY=firestore
CAMPUSPULSE_FIREBASE_PROJECT=campuspulse-ai-1021
# LOCAL KEY SLOT: absolute path to your service account JSON (or leave empty for firebase-key.json).
CAMPUSPULSE_FIREBASE_CREDENTIALS=
# VERTEX SLOTS: project and available model ID; these are not API keys.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
CAMPUSPULSE_VERTEX_MODEL=
CAMPUSPULSE_ALLOW_CLOUD=1
# Shared random value (32+ characters); same Secret Manager secret in both cloud services.
CAMPUSPULSE_LMS_SESSION_SECRET=
# Fill after a successful deployment; leave empty to run Vertex AI locally.
CAMPUSPULSE_AGENT_ENGINE_RESOURCE=
# Cloud Run HTTPS origin; leave empty for localhost.
CAMPUSPULSE_PUBLIC_ORIGIN=
# Optional development student IDs; temporary password equals ID. Private demos only.
CAMPUSPULSE_DEMO_STUDENTS=student1,student2,student3,student4,student5
CAMPUSPULSE_LLM_PROVIDER=alem
CAMPUSPULSE_ALEM_MODEL=gemma4
CAMPUSPULSE_ALEM_ENABLED=1
# Alem API key: insert only in ignored .env, never in example files.
CAMPUSPULSE_ALEM_API_KEY=
