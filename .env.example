# LMS local defaults. start-lms.cmd sets these explicitly.
# Only the four Alem settings below are read from a private .env automatically.
# Other settings must be exported into the server environment. Never commit keys.
CAMPUSPULSE_LMS_REPOSITORY=pending
CAMPUSPULSE_ALLOW_CLOUD=0
CAMPUSPULSE_MODE=local
CAMPUSPULSE_TRANSPORT=mcp
# Optional Alem Gemma provider (the local .local/alem.json profile is also supported).
# CAMPUSPULSE_LLM_PROVIDER=alem
# CAMPUSPULSE_ALEM_MODEL=gemma4
# CAMPUSPULSE_ALEM_ENABLED=1
# CAMPUSPULSE_ALEM_API_KEY= (set only in ignored .env or server environment)
# To select Vertex explicitly: CAMPUSPULSE_LLM_PROVIDER=vertex
# Vertex AI through Google Gen AI SDK + ADC. No Developer API key.
# Set the explicit project ID supplied by the user; never guess a project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Set an agreed Gemini model ID available in that project/location. No fallback.
CAMPUSPULSE_VERTEX_MODEL=
# CAMPUSPULSE_ALLOW_CLOUD stays 0 during preparation and offline verification.
# Optional: a private session signing secret for local development.
# If omitted, a fresh secret is generated in memory on each server start.
# CAMPUSPULSE_LMS_SESSION_SECRET=

# Persistent Firestore storage (explicit opt-in; no model/cloud deployment enabled).
# CAMPUSPULSE_LMS_REPOSITORY=firestore
# CAMPUSPULSE_FIREBASE_PROJECT=campuspulse-ai-1021
# CAMPUSPULSE_FIRESTORE_DATABASE=(default)
# Local: absolute path, or default firebase-key.json in the repository root.
# CAMPUSPULSE_FIREBASE_CREDENTIALS=C:\private\firebase-key.json
# Cloud: use the attached service account / Application Default Credentials.
# CAMPUSPULSE_FIREBASE_CREDENTIALS=adc
# GOOGLE_APPLICATION_CREDENTIALS is also supported for ADC on a local machine.
